# Instance image: API + statically built admin on one origin. One image
# shared by every client — nothing client-specific is baked at build time.
#
#   docker build -f Dockerfile.instance -t commun-instance .
FROM oven/bun:1 AS build
WORKDIR /app

COPY package.json bun.lock ./
COPY apps/api/package.json apps/api/
COPY apps/admin/package.json apps/admin/
COPY packages/core/package.json packages/core/
COPY packages/editor/package.json packages/editor/
COPY packages/apidae-sync/package.json packages/apidae-sync/
COPY apps/portal/package.json apps/portal/
RUN bun install --frozen-lockfile

COPY . .
# Public browser token (pk.*), platform-wide: the admin is statically
# generated, so its runtime config freezes here — a deploy-time env cannot
# inject it.
ARG NUXT_ENV_MAPBOX_TOKEN
ENV NUXT_ENV_MAPBOX_TOKEN=$NUXT_ENV_MAPBOX_TOKEN
# CRITICAL ORDER: the admin is generated BEFORE the API build and dropped in
# its public/ folder. Nitro freezes its public-asset manifest at build time —
# files copied afterwards get served as text/html through the SPA fallback.
RUN cd apps/admin && bun run generate
RUN mkdir -p apps/api/public && cp -R apps/admin/.output/public/. apps/api/public/
RUN bun --filter @commun/api build

FROM oven/bun:1 AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV COMMUN_DATA_DIR=/data
ENV COMMUN_MIGRATIONS_DIR=/app/drizzle

# .output already embeds the admin (public/ is in the Nitro manifest).
COPY --from=build /app/apps/api/.output ./.output
COPY --from=build /app/packages/core/drizzle ./drizzle

RUN mkdir -p /data && chown bun:bun /data
USER bun
VOLUME /data
EXPOSE 3000

CMD ["bun", ".output/server/index.mjs"]
