{
  "name": "commun",
  "version": "0.1.0",
  "private": true,
  "description": "commun.app — CMS open source pour les collectivités françaises (AGPL v3)",
  "workspaces": [
    "packages/core",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun --filter @commun/api --filter @commun/admin --elide-lines=0 dev",
    "dev:api": "bun --filter @commun/api dev",
    "dev:admin": "bun --filter @commun/admin dev",
    "dev:docs": "cd docs && bun run dev",
    "build": "bun --filter @commun/api build",
    "build:docs": "cd docs && bun run build",
    "install:docs": "cd docs && bun install",
    "typecheck": "bun --filter '@commun/*' typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun run test:e2e",
    "test:e2e": "bddgen && playwright test",
    "clean": "rm -rf node_modules packages/*/node_modules packages/*/dist apps/*/node_modules apps/*/.nitro apps/*/.output docs/node_modules docs/.output docs/.docs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@playwright/test": "^1.62.0",
    "@trpc/client": "^11.18.0",
    "@types/bun": "latest",
    "@types/node": "^26.1.0",
    "playwright-bdd": "^9.2.0",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@tailwindcss/oxide",
    "esbuild",
    "vue-demi"
  ]
}
