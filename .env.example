# Commun — variables d'environnement de l'instance.
# Copiez ce fichier en `.env` et ajustez les valeurs.
#
# DEV : `bun run dev` (lancé à la racine) charge ce .env et démarre l'API
# (:3001) + l'admin (:3000). Pour un S3 local : `docker compose -f
# docker-compose.dev.yml up -d` puis renseignez les COMMUN_S3_* ci-dessous.

# URL de l'API consommée par l'admin en dev.
NUXT_ENV_API_URL=http://127.0.0.1:3001

# ── Instance ─────────────────────────────────────────────────────────────────

# Répertoire de données (base SQLite). Défaut : ~/.commun
# (fixé à /data dans docker-compose).
COMMUN_DATA_DIR=

# Port publié par docker-compose (défaut 3000).
COMMUN_PORT=3000

# ── Stockage des médias (S3 requis, iso legacy) ──────────────────────────────
# Bucket + identifiants renseignés → stockage S3-compatible (Scaleway, MinIO,
# Garage…). Sans configuration, les opérations médias échouent explicitement.

COMMUN_S3_ENDPOINT=
COMMUN_S3_REGION=fr-par
COMMUN_S3_BUCKET=
COMMUN_S3_ACCESS_KEY=
COMMUN_S3_SECRET_KEY=

# ── Emails transactionnels (webhook, optionnel) ──────────────────────────────
# L'instance ne connaît aucun fournisseur d'email : elle POST un payload JSON
# { template, to, variables, subject, text, sentAt } sur l'URL ci-dessous
# (invitations, mot de passe oublié). L'email arrive DÉJÀ rédigé en français —
# le récepteur (script maison, n8n, relais SaaS…) peut le transférer tel quel
# à n'importe quel fournisseur, ou le recomposer à partir des variables.
# Non configuré : aucun email, le lien d'invitation est copié depuis l'admin.

COMMUN_EMAIL_WEBHOOK_URL=
# Si renseigné, chaque appel porte X-Commun-Signature: sha256=<hmac-sha256(corps)>.
COMMUN_EMAIL_WEBHOOK_SECRET=
# URL publique de l'admin — sert à construire les liens des emails.
COMMUN_ADMIN_URL=

# ── Profil docker-compose `s3` (MinIO embarqué) ──────────────────────────────
# docker compose --profile s3 up -d
# puis pointez COMMUN_S3_ENDPOINT=http://minio:9000, bucket + identifiants ci-dessous.

MINIO_ROOT_USER=commun
MINIO_ROOT_PASSWORD=
