# Commun — variables d'environnement de l'instance.
# Copiez ce fichier en `.env` et ajustez les valeurs.
#
# DEV : `bun run dev` (lancé à la racine) charge ce .env et démarre l'API
# (:3001) + l'admin (:3000). Pour un S3 local : `docker compose -f
# docker-compose.dev.yml up -d` puis renseignez les COMMUN_S3_* ci-dessous.

# URL de l'API consommée par l'admin en dev.
NUXT_ENV_API_URL=http://127.0.0.1:3001

# ── Instance ─────────────────────────────────────────────────────────────────

# Répertoire de données (base SQLite). Défaut : ~/.commun
# (fixé à /data dans docker-compose).
COMMUN_DATA_DIR=

# Port publié par docker-compose (défaut 3000).
COMMUN_PORT=3000

# ── Stockage des médias (S3 REQUIS au démarrage, iso legacy) ─────────────────
# Stockage S3-compatible (Scaleway, MinIO, Garage…). FAIL-FAST : sans bucket +
# identifiants, le serveur refuse de démarrer. En dev :
# `docker compose -f docker-compose.dev.yml up -d` puis les valeurs MinIO.

COMMUN_S3_ENDPOINT=
COMMUN_S3_REGION=fr-par
COMMUN_S3_BUCKET=
COMMUN_S3_ACCESS_KEY=
COMMUN_S3_SECRET_KEY=

# ── Emails transactionnels (webhook d'ÉVÉNEMENTS, REQUIS au démarrage) ───────
# Le serveur POST { email, eventName, eventProperties } sur cette URL —
# payload calqué sur Loops events/send : pointez-la directement sur
# https://app.loops.so/api/v1/events/send avec la clé API Loops en token,
# ou sur votre propre récepteur (n8n, script → SMTP…). FAIL-FAST : sans URL,
# le serveur refuse de démarrer. Événements émis : userInvited,
# passwordResetRequested — avec eventProperties.url (lien à suivre).

COMMUN_EMAIL_WEBHOOK_URL=
# Envoyé en Authorization: Bearer <token> (clé API Loops, secret partagé…).
COMMUN_EMAIL_WEBHOOK_TOKEN=
# URL publique de l'admin — sert à construire les liens des emails.
COMMUN_ADMIN_URL=

