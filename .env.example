# Commun — variables d'environnement de l'instance.
# Copiez ce fichier en `.env` et ajustez les valeurs.

# ── Instance ─────────────────────────────────────────────────────────────────

# Répertoire de données (base SQLite, médias locaux). Défaut : ~/.commun
# (fixé à /data dans docker-compose).
COMMUN_DATA_DIR=

# Port publié par docker-compose (défaut 3000).
COMMUN_PORT=3000

# Origines autorisées en CORS avec credentials, UNIQUEMENT si l'admin n'est
# pas servi par la même origine que l'API.
# Défaut : http://localhost:3000,http://127.0.0.1:3000 (dev local).
COMMUN_ALLOWED_ORIGINS=

# ── Stockage des médias (optionnel) ──────────────────────────────────────────
# Vide → disque local (aucune dépendance). Les 3 variables bucket/access/secret
# renseignées → driver S3-compatible (Scaleway, MinIO, Garage…).

COMMUN_S3_ENDPOINT=
COMMUN_S3_REGION=fr-par
COMMUN_S3_BUCKET=
COMMUN_S3_ACCESS_KEY=
COMMUN_S3_SECRET_KEY=

# ── Profil docker-compose `s3` (MinIO embarqué) ──────────────────────────────
# docker compose --profile s3 up -d
# puis pointez COMMUN_S3_ENDPOINT=http://minio:9000, bucket + identifiants ci-dessous.

MINIO_ROOT_USER=commun
MINIO_ROOT_PASSWORD=
